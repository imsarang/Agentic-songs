[Unit]
Description=Shanks host wire loop (Python capture → Redis)
After=network.target sound.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/Projects/shanks/host
Environment=REDIS_URL=redis://127.0.0.1:6380/0
ExecStart=%h/Documents/Projects/shanks/host/run.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
